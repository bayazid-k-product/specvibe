{
  "name": "specvibe",
  "version": "0.2.1",
  "description": "Spec-driven governance and context management for AI coding agents. Plan, apply, unify.",
  "type": "module",
  "license": "MIT",
  "author": "SpecVibe Contributors",
  "homepage": "https://github.com/bayazid-k-product/specvibe#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bayazid-k-product/specvibe.git"
  },
  "bugs": {
    "url": "https://github.com/bayazid-k-product/specvibe/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "ai-agents",
    "spec-driven-development",
    "context-engineering",
    "opencode",
    "claude-code",
    "cursor",
    "gemini-cli",
    "windsurf",
    "copilot",
    "cli",
    "developer-tools"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "specvibe": "./dist/cli.js",
    "sv": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "npm run typecheck && npm run lint && npm run test",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false
}
